# 在项目根目录使用 scripts/init-env.sh 自动生成 .env。
# 手工配置时请为前三项填写独立的高熵随机值，且将文件权限设为 0600。
DB_PASSWORD=
SESSION_SECRET=
ADMIN_PASSWORD=
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
WEB_PORT=8080

# 服务器：PUBLIC_ORIGIN=https://game.hidewnd.cn，COOKIE_SECURE=true
# LAN_ORIGINS=http://192.168.3.61:8080,http://192.168.3.65:8801
# FIELD_WARS_DATA_DIR=/home/hidewnd/docker/field-wars/data/postgres
