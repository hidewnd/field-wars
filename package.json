{
  "name": "field-wars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --config apps/field-wars/vite.config.ts",
    "build": "tsc -p tsconfig.server.json && vite build --config apps/field-wars/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p apps/field-wars/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "migrate": "tsx server/migrate.ts",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/websocket": "11.2.0",
    "@noble/hashes": "2.4.0",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "vue": "3.5.43",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "vue-tsc": "3.1.1"
  }
}
